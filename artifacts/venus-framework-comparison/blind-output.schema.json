{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "trial",
    "input",
    "raw",
    "display",
    "scores",
    "notes"
  ],
  "additionalProperties": false,
  "properties": {
    "trial": {
      "type": "string"
    },
    "input": {
      "type": "string"
    },
    "raw": {
      "type": "string"
    },
    "display": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "speaker",
          "text"
        ],
        "properties": {
          "speaker": {
            "type": [
              "string",
              "null"
            ]
          },
          "text": {
            "type": "string"
          }
        }
      }
    },
    "scores": {
      "type": "object",
      "properties": {
        "flirtEnjoyment": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 4
        },
        "attractionTension": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 4
        },
        "characterAppeal": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 4
        },
        "interweaving": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 4
        },
        "responsiveness": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 4
        },
        "continuity": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 4
        }
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
